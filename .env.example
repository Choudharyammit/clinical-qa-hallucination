# ============================================================
# Clinical QA System — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- HuggingFace (free tier, no auth needed for public models) ---
HUGGINGFACE_HUB_TOKEN=hf_your_token_here

# --- LLM Configuration ---
LLM_MODEL_NAME=BioMistral/BioMistral-7B-DARE
LLM_QUANTIZATION=4bit
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.1
LLM_DEVICE=auto

# --- Embeddings ---
EMBEDDING_MODEL=pritamdeka/BioBERT-mnli-snli-scinli-scitail-mednli-stsb
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# --- Vector Store (ChromaDB) ---
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=medical_corpus
CHROMA_DISTANCE_METRIC=cosine

# --- Reranker ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5

# --- NLI / Hallucination Detection ---
NLI_MODEL=microsoft/deberta-v3-base
NLI_ENTAILMENT_THRESHOLD=0.7
NLI_BATCH_SIZE=8

# --- RAG Pipeline ---
RETRIEVER_TOP_K=10
RETRIEVER_MMR_LAMBDA=0.5
MAX_CONTEXT_CHUNKS=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=false
API_MAX_QUERY_LENGTH=1000
API_RATE_LIMIT=60

# --- MLflow ---
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=clinical-qa-hallucination

# --- PubMed API (no auth required for basic access) ---
PUBMED_EMAIL=1187247@student.ljmu.ac.uk
PUBMED_MAX_ABSTRACTS=50000
PUBMED_BATCH_SIZE=200

# --- Evaluation ---
EVAL_BATCH_SIZE=16
EVAL_MAX_SAMPLES=500
MEDQA_TEST_SUBSET=500

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/clinical_qa.log

# --- Random Seeds (reproducibility) ---
RANDOM_SEED=42
NUMPY_SEED=42
TORCH_SEED=42
